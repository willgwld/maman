# =================================================================
# MAMANZEN - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# =================================================================
# Copiez ce fichier vers .env pour vos tests locaux ou configurez
# ces variables directement dans le tableau de bord Vercel / Cloud Run.
# NE JAMAIS COMMITER DE CLÉS DE PRODUCTION EN CLAIR DANS CE FICHIER.

# Supabase Database & Authentication (Obligatoire)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_public_supabase_ici

# Google Auth & OAuth Configuration (Optionnel pour connexion Google)
GOOGLE_CLIENT_ID=votre_google_client_id_ici.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret_ici
VITE_GOOGLE_CLIENT_ID=votre_google_client_id_ici.apps.googleusercontent.com
